# Copy to .env and set local values. .env is ignored by Git and never backed up.
# Integrated: train_baseline.py, train_hard_negatives.py, data_prep/prepare_data.py,
# prepare_medgemma.py, backup_data_to_hf.py and download_data_from_hf.py.
# MedGemma configurable training and root evaluate.py/infer.py share these paths.
# CLI overrides > exported environment > .env > defaults.
# Relative paths are resolved from the repository root, not the current directory.
# Quote values containing spaces. Use absolute paths or ~, not $VARIABLE expansion.

DATA_DIR=data
RUNS_DIR=runs
# Transfer scratch files live here. YOLO prep defaults its persistent Kaggle cache
# to CACHE_DIR/kagglehub unless KAGGLEHUB_CACHE is set. Keep that image cache:
# freshly prepared YOLO images are symlinks to it. Put CACHE_DIR outside datasets.
CACHE_DIR=.cache
MANIFEST_PATH=split_manifest.csv
CANDIDATES_PATH=hard_negatives_review/ranked_negatives.csv

# Set repositories you have permission to WRITE to, or pass --repo-id to a trainer.
# Baseline requires HF backup configuration unless --no-hf-backup is selected.
# HN training always requires private HF backups; it uses the same HF_REPO_ID.
# HF_REPO_ID=your-username/grazpedwri-yolo26-checkpoints
# MEDGEMMA_HF_REPO_ID=your-username/medgemma-fracture-checkpoints
# Used as the backup destination AND restore source; must be a private repository.
# DATASET_HF_REPO_ID=your-username/grazpedwri-frozen-splits
# Backup prints its snapshot ID and exact commit. Restore with both:
# python3 download_data_from_hf.py --snapshot <snapshot-id> --revision <commit-sha>
# Without --revision, restore pins HEAD once and saves the resolved commit in a
# DATA_DIR/restore-*.json receipt. Existing datasets are never overwritten.
# All four data commands support --print-config without downloads or GPU packages.

# Leave HF_HOME unset to reuse the current Hugging Face login/cache location.
# Changing HF_HOME may require authenticating again at the new location.
# HF_HOME=/absolute/path/to/huggingface
# KAGGLEHUB_CACHE=/absolute/path/to/kagglehub

# Prefer `hf auth login` or an externally supplied HF_TOKEN. Never commit tokens.
# Training settings belong on the CLI, not here:
# ./.venv/bin/python train_baseline.py --imgsz 640 --seed 43 --epochs 100 --print-config
# python3 train_hard_negatives.py --imgsz 960 --print-config
# HN uses the frozen CSV/hash and 178-image pool by default; do not re-mine or edit it.
# Defaults: 640px -> batch 35; 960px -> batch 14; 100 epochs; seed 43; logical device 0.
# Select a physical GPU with CUDA_VISIBLE_DEVICES before launching the command.
# HN requires exactly one visible GPU. Run long training jobs inside tmux.

# MedGemma training is available through medgemma_training/run_medgemma.py.
# It supports any positive GPU count on ONE machine. Run it from the repository
# root with the existing .venv, not .venv-medgemma.
# MEDGEMMA_PYTHON=.venv/bin/python
# Private recovery destination: set in your ignored .env or pass --repo-id/--hf-repo-id.
# MEDGEMMA_HF_REPO_ID=your-username/your-private-medgemma-backups
# Optional configured CUDA IDs. Process environment beats this .env value; --devices wins.
# MEDGEMMA_CUDA_VISIBLE_DEVICES=0,1,2
# Optional positive accumulation per GPU. Fixed microbatch is 1; effective batch is N * accumulation.
# MEDGEMMA_GRAD_ACCUM=4
# CUDA_DEVICE_ORDER=PCI_BUS_ID
# NCCL_P2P_DISABLE=1
# NCCL_IB_DISABLE=1
# Leave HF_HOME unset to reuse the current login/cache. If that existing location is
# /workspace/.hf_home, set the following path explicitly:
# HF_HOME=/workspace/.hf_home
# Offline preview does not check GPU availability or live NCCL:
# ./.venv/bin/python medgemma_training/run_medgemma.py smoke --num-gpus 1 --print-config
# ./.venv/bin/python medgemma_training/run_medgemma.py smoke --devices 0,1,2 --grad-accum 4 --print-config
# Local smoke-evidence check (same N, devices, accumulation, and recipe as smoke):
# ./.venv/bin/python medgemma_training/run_medgemma.py train --num-gpus 1 --check-ready

# Evaluation/inference: one logical CUDA device per invocation, not training DDP.
# PREDICTION_DEVICE=0
# PREDICTION_PYTHON=.venv/bin/python
# Checkpoint cache defaults to CACHE_DIR/fracture_evaluation. Outputs use RUNS_DIR.
# BOTH evaluators use DATA_DIR/grazpedwri_yolo; inference requires --source.
# HF_REPO_ID is the YOLO source and MEDGEMMA_HF_REPO_ID is the MedGemma source.
# Local --checkpoint runs do not use a configured HF repository.
# python3 evaluate.py yolo26 --print-config
# python3 infer.py medgemma --print-config
# Test requires --split test --protocol matching/validation/evaluation.json.
# --protocol supplies frozen cutoff/settings; inference --conf is exploratory.
